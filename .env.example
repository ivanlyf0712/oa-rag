# ── MySQL ───────────────────────────────────────────────────────────
# Local dev: point at your MySQL. Docker: compose overrides DB_HOST/PORT
# for the app container; these values are used for the mysql service itself
# and by  (dump from the host DB).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oa_rag
DB_USER=oa
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4
# Root password for the dockerized MySQL (compose mysql service only).
DB_ROOT_PASSWORD=changeme-root

# ── LLM proxy (LiteLLM-compatible) ──────────────────────────────────
LITELLM_API_KEY=sk-...
LITELLM_BASE_URL=https://your-litellm-proxy.example.com/
LITELLM_MODEL=your-model-name
LITELLM_TIMEOUT=45
LITELLM_MAX_TOKENS=2048

# ── Models ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-base
# Local dev with primed HF cache: 1. In docker: leave unset — the app
# auto-detects from the hf-cache volume (core.config.ensure_hf_offline).
HF_HUB_OFFLINE=1

# ── Index (optional; default apps/search_index) ─────────────────────
# INDEX_PATH=/abs/path/to/search_index

# ── Hindsight cross-session memory (the server runs as a compose service) ──
# Hindsight uses the same LiteLLM proxy as the app (LITELLM_API_KEY / LITELLM_BASE_URL
# / LITELLM_MODEL above). No separate LLM key needed — it reuses your existing config.
#
# Memory server API :8888 (internal docker network) and Web UI :9999 (browser).
# When HINDSIGHT_BANK_ID is set, each Ask turn is retained to the bank, and
# queries with explicit cross-session references ("last time", "previously",
# 上次/之前/还记得...) trigger a gated recall injected into the agent context.
# The bank's disposition (edited in the Web UI) drives the answer persona.
# HINDSIGHT_API_URL=http://hindsight:8888    # overridable; compose default is correct
# HINDSIGHT_BANK_ID=oa-rag
# HINDSIGHT_API_TIMEOUT=10
# Web UI base URL (browser-reachable) for the "Adjust in Hindsight" links on
# the Settings page.
# HINDSIGHT_UI_URL=http://localhost:9999
